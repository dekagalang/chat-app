{
  "name": "chat-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.local next dev",
    "type-check": "tsc --noEmit",
    "build": "pnpm type-check && next build",
    "start": "dotenv -e .env.production next start",
    "lint": "eslint",
    "clean": "rm -rf .next/cache",
    "clean:all": "rm -rf .next",
    "deploy": "bash scripts/publish-build.sh",
    "deploy:build": "bash scripts/publish-build.sh",
    "deploy:server": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@tanstack/react-query": "^5.100.11",
    "antd": "^6.4.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.32.1"
}
